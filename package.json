{
  "name": "kosensai2026",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "set -a; [ ! -f .env ] || . ./.env; set +a; concurrently -k -n web,api \"pnpm --filter @kosensai/web dev\" \"pnpm --filter @kosensai/api dev\"",
    "dev:web": "set -a; [ ! -f .env ] || . ./.env; set +a; pnpm --filter @kosensai/web dev",
    "dev:api": "set -a; [ ! -f .env ] || . ./.env; set +a; pnpm --filter @kosensai/api dev",
    "build": "set -a; [ ! -f .env ] || . ./.env; set +a; turbo run build",
    "start": "set -a; [ ! -f .env ] || . ./.env; set +a; concurrently -k -n web,api \"pnpm --filter @kosensai/web start\" \"pnpm --filter @kosensai/api start\"",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "payload:types": "pnpm --filter @kosensai/api payload:types",
    "payload:migrate": "pnpm --filter @kosensai/api payload:migrate",
    "payload:push": "pnpm --filter @kosensai/api payload:push",
    "push": "pnpm --filter @kosensai/api payload:push"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@types/node": "^22.10.2",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "pnpm": "^11.10.0"
  }
}
